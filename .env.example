# ============================================================
#  Plantilla de variables de entorno - capstone_sag
#  Copia este archivo como `.env` y completa los valores reales.
#      cp .env.example .env
#  El archivo .env real NO se sube al repositorio.
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false

# --- Sesión Express ---
SESSION_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# --- Base de datos (SQL Server / Azure SQL) ---
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_SERVER=tu_servidor.database.windows.net
DB_DATABASE=tu_base_de_datos
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# --- Mapbox (token público del cliente) ---
MAPBOX_TOKEN=tu_token_publico_de_mapbox
